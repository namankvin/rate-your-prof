# Backend-only settings. Never prefix a secret with VITE_.
APP_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

# setup:local generates an isolated MySQL instance and credentials on port 3307.
# If using your own running MySQL instance, change these values instead.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=rate_my_prof
DB_USER=rate_my_prof_app
DB_PASSWORD=replace-with-your-database-password

# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_SECRET=replace-with-another-independent-random-secret
ANONYMOUS_SECRET=replace-with-another-independent-random-secret

# Student domain confirmed by the project owner.
STUDENT_EMAIL_DOMAINS=student.nitw.ac.in

# Development file delivery saves private messages under .local/mail/.
# Production requires MAIL_MODE=smtp and real SMTP configuration.
MAIL_MODE=file
MAIL_FROM=RateMyProf <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Used only by admin:create, not by registration or the server.
ADMIN_EMAIL=admin@rate-my-prof.local
# Leave blank for admin:create to generate a password in .local/admin-account.txt.
ADMIN_PASSWORD=

# Set only when your production server is behind a trusted reverse proxy.
TRUST_PROXY=false
