{
  "name": "rate-my-prof",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:local": "node server/scripts/local-mysql.js start",
    "db:stop": "node server/scripts/local-mysql.js stop",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "admin:create": "node server/scripts/create-admin.js",
    "setup:local": "node server/scripts/setup-local.js",
    "test": "node --test server/tests/unit.test.js",
    "test:integration": "node --test --test-concurrency=1 server/tests/integration.test.js",
    "catalog:import": "node server/scripts/import-curriculum.js"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.0",
    "nodemailer": "^10.0.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
